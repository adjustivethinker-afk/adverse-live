# =============================================================
#  AdVerse Live — Backend (NestJS) environment variables
# =============================================================
# For local dev: copy this file to `.env`.
# For production (Render / Fly / Railway): paste these as
# environment variables in the host's dashboard.
# All third-party services listed here have a generous free tier.
# =============================================================

# ---- Server -------------------------------------------------
PORT=4000
NODE_ENV=development
# Public URL of the FRONTEND (used to build deep links in emails etc.)
APP_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins. In prod set this to
# your real frontend domain(s), e.g.
#   CORS_ORIGINS=https://adverse.live,https://www.adverse.live
CORS_ORIGINS=http://localhost:3000
# Set to "1" to expose Swagger docs in production at /api/docs
ENABLE_SWAGGER=0

# ---- Database  (use Neon / Supabase free tier) --------------
# Neon dashboard: copy the "Pooled connection" URL (port 5432) and
# add `?sslmode=require` if not present.
DATABASE_URL=postgresql://user:pass@host:5432/adverse?sslmode=require

# ---- Redis  (use Upstash free tier) -------------------------
# Upstash dashboard → "Endpoints" → use the rediss:// URL (TLS).
REDIS_URL=rediss://default:pass@host:6379

# ---- JWT ----------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-32+chars
JWT_REFRESH_SECRET=replace-me-with-32+chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Storage  (Cloudinary free 25GB) ------------------------
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Mail  (Resend free 3000/mo  OR  Brevo free 300/day) ----
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=AdVerse Live <noreply@adverse.live>

# ---- Push notifications  (Firebase Cloud Messaging free) ----
FIREBASE_SERVER_KEY=

# ---- WebRTC TURN  (Metered free 50 GB/mo) -------------------
TURN_URL=turn:turn.metered.live:80
TURN_USER=
TURN_PASS=

# ---- OAuth (optional, all free) -----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
