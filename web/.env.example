# =============================================================
#  AdVerse Live — Frontend (Next.js) environment variables
# =============================================================
# Copy this file to `.env.local` for local dev, or paste these
# into Vercel's "Environment Variables" panel for production.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# =============================================================

# Public site URL (no trailing slash) — used by metadata, OG tags, sitemap.
# Local:      http://localhost:3000
# Production: https://adverse.live (or your real domain on Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# REST API base URL.
# Local:      http://localhost:4000/api/v1
# Production: https://api.adverse.live/api/v1  (your Render/Fly backend)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# WebSocket / realtime URL for voice rooms + chat.
# Local:      ws://localhost:4000/realtime
# Production: wss://api.adverse.live/realtime
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4000/realtime
