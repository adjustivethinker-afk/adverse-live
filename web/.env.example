# =============================================================
#  AdVerse Live — Environment variables (Static export)
# =============================================================
# Copy this file to `.env.local` for local dev. Because the build
# is exported to static HTML/CSS/JS and uploaded to Hostinger
# `public_html`, ALL variables MUST be NEXT_PUBLIC_* (they're
# embedded in the client bundle).
# =============================================================

# ---- Site -----------------------------------------------------
# No trailing slash. Used by metadata, OG tags, sitemap.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ---- Backend API ---------------------------------------------
# Base URL for the REST API. The app expects the API mounted under
# `/backend/api/` by default; adjust if you host the PHP API elsewhere.
NEXT_PUBLIC_API_BASE=/backend/api
